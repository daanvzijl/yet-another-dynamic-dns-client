amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["editorconfig_checker"] = Builtins.editorconfig_checker
    ["prettier"] = Builtins.prettier
    ["golangci_lint"] = Builtins.golangci_lint
    ["gomod_tidy"] = Builtins.gomod_tidy
    ["go_vuln_check"] = Builtins.go_vuln_check
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
